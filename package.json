{
  "name": "@lamervon/dsh-spider-solitaire",
  "version": "1.0.1",
  "type": "module",
  "description": "Spider Solitaire for the DeepSeek Harness right Sidebar: play a hand beside the conversation, with the board and statistics kept on this device",
  "license": "MIT",
  "author": "lamervon",
  "homepage": "https://github.com/lamervon/dsh-spider-solitaire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamervon/dsh-spider-solitaire.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/lamervon/dsh-spider-solitaire/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "spider-solitaire",
    "solitaire",
    "card-game"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "LICENSE",
    "icon.svg",
    "src"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
